# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini: embeddings (gemini-embedding-001) and chat model
GEMINI_API_KEY=

# Qdrant vector store (Qdrant Cloud free tier, or http://localhost:6333 with Docker)
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=Orange-DataExplorer

# Knowledge base folder, relative to the project or absolute (default: knowledge-base)
INGEST_DATA_PATH=examples/knowledge-base

# Flask session signing key (a development fallback is used if empty)
SECRET_KEY=

# --- Optional: chat model tuning (defaults in config.py) ---
# LLM_MODEL=gemini-3-flash-preview
# LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# LLM_THINKING_LEVEL=low
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=1

# --- Optional: embedding pacing for the free tier (ingest.py) ---
# EMBED_BATCH=90
# EMBED_PAUSE_S=61

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
